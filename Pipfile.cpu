[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[[source]]
url = "https://download.pytorch.org/whl/cpu"
verify_ssl = true
name = "pytorch"

[packages]
# Keep application versions aligned with Pipfile; CI uses CPU-only PyTorch wheels.
numpy = "==2.4.3"
pandas = "==3.0.1"
scikit-learn = "==1.8.0"
matplotlib = "==3.10.8"
seaborn = "==0.13.2"
tqdm = "==4.67.3"
pillow = "==12.1.1"
pyyaml = "==6.0.3"
requests = "==2.32.5"
pyarrow = "==20.0.0"
polars = "==1.43.2"
boto3 = "==1.42.70"
google-cloud-storage = "==3.9.0"
sentence-transformers = "==5.3.0"
fastapi = "==0.135.1"
pydantic = "==2.12.5"
uvicorn = "==0.42.0"
clearml = "==2.1.2"
torch = {version = "==2.5.1+cpu", index = "pytorch"}
torchvision = {version = "==0.20.1+cpu", index = "pytorch"}
torchaudio = {version = "==2.5.1+cpu", index = "pytorch"}
# Upstream PyTorch wheels require these versions; the old solver allowed newer ones.
sympy = "==1.13.1"
mpmath = "==1.3.0"

# Pin existing transitive dependencies so this migration does not upgrade them.
annotated-doc = "==0.0.4"
annotated-types = "==0.7.0"
anyio = "==4.12.1"
attrs = "==25.4.0"
botocore = "==1.42.70"
certifi = "==2026.7.22"
cffi = "==2.0.0"
charset-normalizer = "==3.4.6"
click = "==8.3.1"
contourpy = "==1.3.3"
cryptography = "==46.0.5"
cycler = "==0.12.1"
filelock = "==3.25.2"
fonttools = "==4.62.0"
fsspec = "==2026.2.0"
furl = "==2.1.4"
google-api-core = "==2.30.0"
google-auth = "==2.49.1"
google-cloud-core = "==2.5.0"
google-crc32c = "==1.8.0"
google-resumable-media = "==2.8.0"
googleapis-common-protos = "==1.73.0"
h11 = "==0.16.0"
hf-xet = "==1.4.2"
huggingface-hub = "==0.36.0"
idna = "==3.11"
jinja2 = "==3.1.6"
jmespath = "==1.1.0"
joblib = "==1.5.3"
jsonschema = "==4.26.0"
jsonschema-specifications = "==2025.9.1"
kiwisolver = "==1.5.0"
markupsafe = "==3.0.3"
networkx = "==3.6.1"
orderedmultidict = "==1.0.2"
packaging = "==26.0"
pathlib2 = "==2.3.7.post1"
polars-runtime-32 = "==1.43.2"
proto-plus = "==1.27.1"
protobuf = "==6.31.1"
psutil = "==7.2.1"
pyasn1 = "==0.6.3"
pyasn1-modules = "==0.4.2"
pycparser = "==2.22"
pydantic-core = "==2.41.5"
pyjwt = "==2.10.1"
pyparsing = "==3.3.2"
python-dateutil = "==2.9.0.post0"
referencing = "==0.37.0"
regex = "==2026.2.28"
rpds-py = "==0.30.0"
s3transfer = "==0.16.0"
safetensors = "==0.7.0"
scipy = "==1.17.1"
six = "==1.17.0"
starlette = "==0.52.1"
threadpoolctl = "==3.6.0"
tokenizers = "==0.22.2"
transformers = "==4.57.6"
typing-extensions = "==4.15.0"
typing-inspection = "==0.4.2"
urllib3 = "==2.5.0"

[dev-packages]
pytest = "==9.0.2"
iniconfig = "==2.3.0"
pluggy = "==1.6.0"
pygments = "==2.19.2"

[requires]
python_full_version = "3.11.15"
